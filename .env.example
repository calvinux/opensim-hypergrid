# Copy this file to .env and replace every example value before starting the grid.
# Hypergrid address: http://PUBLIC_HOST:PUBLIC_PORT/
PUBLIC_HOST=grid.example.invalid
PUBLIC_PORT=8002

REGION_NAME=Welcome
REGION_LOCATION=1000,1000

GRID_NAME=Example Grid
GRID_NICK=example
ESTATE_NAME=Example Estate
ADMIN_FIRST=Grid
ADMIN_LAST=Admin
ADMIN_PASS=replace-with-a-unique-strong-password
ADMIN_EMAIL=admin@example.invalid

# LAN IP of the host running the container. The web console listens on this IP.
HOST_LAN_IP=192.168.1.50
# Web console (never forward this port on your router).
WEB_USER=admin
WEB_PASS=replace-with-a-unique-password
WEB_PORT=8090

# Optional read-only account (use a password of at least 8 characters).
#WEB_VIEWER_USER=viewer
#WEB_VIEWER_PASS=
# Optional six-digit TOTP authentication secret (Base32).
#WEB_TOTP_SECRET=

# Number of backups to keep; automatic backup frequency in hours (0 = disabled).
BACKUP_KEEP=10
BACKUP_EVERY_HOURS=0

# Optional alert channels. Configure one or more, and keep webhook/token values private.
#ALERT_NTFY_URL=
ALERT_DISCORD_WEBHOOK=
#ALERT_TELEGRAM_TOKEN=
#ALERT_TELEGRAM_CHAT=
# 1 = also notify on avatar logins/logouts.
ALERT_LOGINS=0
ALERT_DISK_PCT=90

# Optional daily restart (HH:MM in container time); leave unset to disable.
#RESTART_DAILY_AT=04:30
RESTART_NOTICE_MIN=10
TZ=Europe/Paris

# Maximum upload size for OAR/IAR files, in MB.
MAX_UPLOAD_MB=2048

# Pin a release/tag rather than tracking master for more reproducible builds.
OPENSIM_REF=master
DOTNET_VERSION=8.0
